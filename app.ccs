* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* DARK UI */
body {
  font-family: Arial, sans-serif;
  background: #0b0b0b;
  color: #eaeaea;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #1f1f1f;
}

header h1 {
  font-size: 20px;
}

.score-box {
  background: #1a1a1a;
  padding: 8px 15px;
  border-radius: 20px;
  font-size: 14px;
}

/* MAIN */
main {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  padding: 20px;
}

/* PLAYER */
.video-container {
  width: 100%;
  aspect-ratio: 16 / 9;
}

iframe {
  width: 100%;
  height: 100%;
  border-radius: 12px;
  border: none;
}

/* COURSES SIDE PANEL */
.courses h2 {
  margin-bottom: 10px;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

/* CARD */
.card {
  display: flex;
  gap: 10px;
  cursor: pointer;
  background: #141414;
  padding: 8px;
  border-radius: 10px;
  transition: 0.2s;
}

.card img {
  width: 120px;
  border-radius: 8px;
}

.card p {
  font-size: 14px;
}

.card:hover {
  background: #1f1f1f;
  transform: scale(1.02);
}

/* MOBILE */
@media (max-width: 768px) {
  main {
    grid-template-columns: 1fr;
  }

  .grid {
    flex-direction: row;
    overflow-x: auto;
  }

  .card {
    min-width: 200px;
  }
}