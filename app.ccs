* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* DARK BLUE UI */
body {
  font-family: 'Segoe UI', sans-serif;
  background: linear-gradient(180deg, #0b1a33, #050d1f);
  color: #e6ecff;
  padding: 15px;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.score {
  background: rgba(255,255,255,0.08);
  padding: 8px 14px;
  border-radius: 20px;
}

/* PLAYER */
.player iframe {
  width: 100%;
  height: 220px;
  border-radius: 16px;
  border: none;
  margin-bottom: 25px;
}

/* SECTION */
.section h2 {
  margin-bottom: 15px;
}

/* ✅ YOUTUBE STYLE GRID */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 18px;
}

/* CARD */
.card {
  cursor: pointer;
  transition: 0.25s;
}

.card img {
  width: 100%;
  border-radius: 12px;
}

.card h3 {
  margin-top: 8px;
  font-size: 15px;
}

.card p {
  font-size: 13px;
  opacity: 0.7;
}

/* HOVER */
.card:hover {
  transform: scale(1.05);
}

/* DESKTOP PLAYER */
@media (min-width: 768px) {
  .player iframe {
    height: 400px;
  }
}