:root{
  --bg:#0f0f0f;
  --card:#181818;
  --text:white;
}

.light{
  --bg:#ffffff;
  --card:#f2f2f2;
  --text:#111;
}

body{
  margin:0;
  font-family:system-ui;
  background:var(--bg);
  color:var(--text);
}

/* TOPBAR */
.topbar{
  display:flex;
  gap:10px;
  align-items:center;
  padding:10px;
  background:var(--card);
  position:sticky;
  top:0;
}

.topbar input{
  flex:1;
  padding:8px;
  border-radius:20px;
  border:none;
}

.topbar button{
  border:none;
  padding:8px 12px;
  border-radius:10px;
  cursor:pointer;
}

/* LAYOUT */
.layout{display:flex;}

/* SIDEBAR */
.sidebar{
  width:200px;
  background:var(--card);
  min-height:100vh;
  padding:10px;
}

.sidebar div{
  padding:10px;
  cursor:pointer;
  border-radius:6px;
}

.sidebar div:hover{background:#222;}

/* MAIN */
.main{flex:1;padding:10px;}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
  gap:12px;
}

/* CARD */
.card{
  background:var(--card);
  border-radius:12px;
  overflow:hidden;
  cursor:pointer;
  transition:0.25s;
}

.card img{width:100%;}

.card:hover{
  transform:translateY(-5px) scale(1.03);
}

/* PLAYER */
#player{
  display:none;
  position:sticky;
  top:60px;
  background:black;
}

#player iframe{
  width:100%;
  height:250px;
}

/* DASHBOARD */
.dashboard{
  background:var(--card);
  padding:12px;
  border-radius:12px;
}

/* QUIZ */
#quiz{
  background:var(--card);
  padding:15px;
  border-radius:12px;
  margin-top:10px;
}

/* TOAST */
.toast{
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  background:#ff4c60;
  padding:10px 20px;
  border-radius:20px;
}

/* MOBILE */
@media(max-width:700px){
  .sidebar{display:none;}
  .grid{grid-template-columns:repeat(2,1fr);}
}