* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* DARK THEME ALWAYS */
body {
  font-family: Arial, sans-serif;
  background: #0f0f0f;
  color: #ffffff;
}

/* HEADER */
header {
  padding: 15px 20px;
  font-size: 20px;
  font-weight: bold;
  border-bottom: 1px solid #222;
}

/* PLAYER */
.player-section {
  padding: 20px;
}

.video-container {
  width: 100%;
  max-width: 900px;
  aspect-ratio: 16 / 9;
  margin-top: 10px;
}

iframe {
  width: 100%;
  height: 100%;
  border-radius: 12px;
  border: none;
}

/* COURSES */
.courses {
  padding: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 15px;
}

/* CARD */
.card {
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.card img {
  width: 100%;
  border-radius: 12px;
}

.card p {
  margin-top: 8px;
  font-size: 14px;
}

/* HOVER EFFECT */
.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(255,255,255,0.1);
}