body{
  margin:0;
  font-family:system-ui;
  background:#0f0f0f;
  color:white;
}

/* TOPBAR */
.topbar{
  display:flex;
  justify-content:space-between;
  padding:10px;
  background:#111;
  position:sticky;
  top:0;
}

.topbar input{
  width:50%;
  padding:8px;
  border-radius:20px;
  border:none;
}

/* LAYOUT */
.layout{display:flex;}

/* SIDEBAR */
.sidebar{
  width:200px;
  background:#111;
  min-height:100vh;
  padding:10px;
}

.sidebar div{
  padding:10px;
  cursor:pointer;
  border-radius:6px;
}

.sidebar div:hover{background:#222;}

/* MAIN */
.main{flex:1;padding:10px;}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
  gap:12px;
}

/* CARD */
.card{
  background:#181818;
  border-radius:10px;
  overflow:hidden;
  cursor:pointer;
  transition:0.3s;
}

.card img{width:100%;}

.card:hover{transform:scale(1.05);}

/* PLAYER */
#player{
  display:none;
  position:sticky;
  top:60px;
  background:black;
}

#player iframe{
  width:100%;
  height:250px;
}

/* DASHBOARD */
.dashboard{
  background:#151515;
  padding:12px;
  border-radius:10px;
  margin-bottom:10px;
}

.stats{
  display:flex;
  gap:20px;
}

/* QUIZ */
#quiz{
  background:#1a1a1a;
  padding:15px;
  border-radius:10px;
  margin-top:10px;
}

/* TOAST */
.toast{
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  background:#ff4c60;
  padding:10px 20px;
  border-radius:20px;
}

/* MOBILE */
@media(max-width:700px){
  .sidebar{display:none;}
  .grid{grid-template-columns:repeat(2,1fr);}
}