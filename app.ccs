body{
  margin:0;
  font-family:system-ui;
  background:#0f0f0f;
  color:white;
}

/* TOP BAR */
.topbar{
  display:flex;
  justify-content:space-between;
  padding:10px;
  background:#111;
  position:sticky;
  top:0;
  z-index:100;
}

.topbar input{
  width:50%;
  padding:6px;
  border-radius:20px;
  border:none;
}

/* PLAYER */
#player{
  display:none;
  background:black;
  position:sticky;
  top:50px;
  z-index:10;
}

#player iframe{
  width:100%;
  height:220px;
}

/* SECTIONS */
.section{
  padding:10px;
}

h3{
  margin:10px 0;
}

/* FEATURED */
.featured{
  position:relative;
  cursor:pointer;
}

.featured img{
  width:100%;
  border-radius:10px;
}

.featured .info{
  position:absolute;
  bottom:10px;
  left:10px;
}

/* ROW */
.row{
  display:flex;
  gap:10px;
  overflow-x:auto;
}

/* CARD */
.card{
  min-width:150px;
  cursor:pointer;
  transition:0.3s;
}

.card img{
  width:100%;
  border-radius:8px;
}

.card:hover{
  transform:scale(1.05);
}

/* QUIZ */
#quiz{
  background:#1a1a1a;
  margin:10px;
  padding:15px;
  border-radius:10px;
}

/* MOBILE */
@media(max-width:600px){
  #player iframe{
    height:200px;
  }

  .card{
    min-width:130px;
  }
}