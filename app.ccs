* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 🌑 PREMIUM BACKGROUND */
body {
  font-family: system-ui, sans-serif;
  background: radial-gradient(circle at top, #0b1f3a, #020617);
  color: #e2e8f0;
}

/* HEADER */
header {
  display: flex;
  justify-content: space-between;
  padding: 15px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

/* SCORE */
.score {
  background: rgba(255,255,255,0.08);
  padding: 6px 14px;
  border-radius: 999px;
  backdrop-filter: blur(10px);
}

/* LAYOUT */
main {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  padding: 20px;
}

/* LEFT */
.video-box iframe {
  width: 100%;
  height: 350px;
  border-radius: 16px;
  border: none;
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
}

.video-info {
  margin-top: 12px;
}

.video-info h2 {
  font-size: 20px;
}

/* RIGHT SIDE */
.right {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* RECOMMENDATION CARD */
.rec-card {
  display: flex;
  gap: 10px;
  background: rgba(255,255,255,0.05);
  padding: 8px;
  border-radius: 14px;
  cursor: pointer;
  transition: 0.25s;
}

.rec-card img {
  width: 120px;
  border-radius: 10px;
}

.rec-card h4 {
  font-size: 14px;
}

.rec-card p {
  font-size: 12px;
  opacity: 0.7;
}

/* HOVER */
.rec-card:hover {
  background: rgba(255,255,255,0.12);
  transform: scale(1.02);
}

/* MOBILE */
@media (max-width: 768px) {
  main {
    grid-template-columns: 1fr;
  }

  .video-box iframe {
    height: 220px;
  }

  .right {
    margin-top: 15px;
  }
}