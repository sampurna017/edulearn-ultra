body {
  font-family: Arial;
  margin: 0;
  background: #f4f4f4;
  color: #000;
}

header {
  padding: 15px;
  background: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-bar {
  display: flex;
  gap: 10px;
}

input {
  padding: 8px;
}

button {
  padding: 8px 12px;
  cursor: pointer;
  border: none;
  background: #333;
  color: white;
  border-radius: 5px;
}

nav {
  padding: 10px;
  background: #ddd;
  display: flex;
  gap: 15px;
}

.progress {
  padding: 15px;
}

.player-section {
  padding: 15px;
}

.video-container {
  width: 100%;
  max-width: 800px;
  aspect-ratio: 16 / 9;
}

iframe {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}

.courses {
  padding: 15px;
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.card {
  width: 220px;
  cursor: pointer;
  transition: transform 0.2s;
}

.card:hover {
  transform: scale(1.05);
}

.card img {
  width: 100%;
  border-radius: 10px;
}

.card p {
  margin: 5px 0;
}

/* DARK MODE */
.dark {
  background: #121212;
  color: white;
}

.dark header {
  background: #1e1e1e;
}

.dark nav {
  background: #222;
}